# Mailgun production email (replace .env.production.local when ready).
# Requires: Mailgun account with ali.kg domain verified + DNS records in Cloudflare.
AUTH_EMAIL_LOGIN_ENABLED=true
AUTH_OTP_DEV_ECHO=false

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.ali.kg
SMTP_PASS=REPLACE_WITH_MAILGUN_SMTP_PASSWORD
SMTP_FROM=AliStore <noreply@ali.kg>

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

// Слайс 3 плана SUPPLY-TO-ORDER: связка «строка клиентского заказа» ↔
// «строка заказа поставщику». Прямой FK Order → PurchaseOrder был бы неверен —
// один PO поставщику агрегирует строки нескольких клиентских заказов, поэтому
// связь идёт через отдельную запись на КАЖДУЮ строку заказа (orderItemId
// уникален: одна запись поставки на строку). purchaseOrderItemId остаётся
// NULL, пока PO поставщику не размещён — на awaiting_supplier его физически
// не существует.
model OrderLineSupply {
  id                   String                      @id @default(cuid())
  orderItem            OrderItem                   @relation(fields: [orderItemId], references: [id])
  orderItemId          String                      @unique
  purchaseOrderItem    PurchaseOrderItem?          @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseOrderItemId  String?                     @unique
  supplierOffer        SupplierOffer?              @relation(fields: [supplierOfferId], references: [id], onDelete: Restrict)
  supplierOfferId      String?
  status               OrderLineSupplyStatus       @default(awaiting_supplier)
  orderedQty           Int                         @default(1)
  receivedQty          Int                         @default(0)
  expectedAt           DateTime?
  actor                String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  quarantineResolution SupplyQuarantineResolution?
  quantityAllocations  SupplyQuantityAllocation[]

  @@index([status])
  @@index([supplierOfferId, status])
}

// Количественный товар, принятый под конкретную клиентскую строку. Это
// отдельный субрегистр: запись не увеличивает свободный InventoryBalance и
// может быть списана только через связанную OrderLineSupply.
model SupplyQuantityAllocation {
  id                String                   @id @default(cuid())
  orderLineSupply   OrderLineSupply          @relation(fields: [orderLineSupplyId], references: [id], onDelete: Restrict)
  orderLineSupplyId String
  purchaseReceipt   PurchaseReceipt          @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  purchaseReceiptId String
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId         String
  location          String
  qty               Int
  returnedQty       Int                      @default(0)
  unitCost          Int
  active            Boolean                  @default(true)
  consumedAt        DateTime?
  valuationIssue    InventoryValuationIssue? @relation(fields: [valuationIssueId], references: [id], onDelete: Restrict)
  valuationIssueId  String?                  @unique
  createdAt         DateTime                 @default(now())

  @@unique([purchaseReceiptId, orderLineSupplyId])
  @@index([orderLineSupplyId, active])
  @@index([productId, active])
}

model SupplyQuarantineResolution {
  id                        String                       @id @default(cuid())
  orderLineSupply           OrderLineSupply              @relation(fields: [orderLineSupplyId], references: [id], onDelete: Restrict)
  orderLineSupplyId         String                       @unique
  product                   Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId                 String
  storePoint                StorePoint                   @relation(fields: [storePointId], references: [id], onDelete: Restrict)
  storePointId              String
  inventoryLocationSnapshot String
  trackingModeSnapshot      StockTrackingMode
  quarantinedQty            Int
  unitCostSnapshot          Int
  imeis                     Json?
  status                    SupplyQuarantineStatus       @default(pending)
  disposition               SupplyQuarantineDisposition?
  proposalReason            String
  proposalEvidence          Json
  proposedBy                String
  proposalIdempotencyKey    String                       @unique
  proposalHash              String
  resolutionReason          String?
  resolutionEvidence        Json?
  resolvedBy                String?
  resolutionIdempotencyKey  String?                      @unique
  resolutionHash            String?
  inventoryMovement         InventoryMovement?           @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  inventoryMovementId       String?                      @unique
  units                     DeviceUnit[]
  createdAt                 DateTime                     @default(now())
  resolvedAt                DateTime?

  @@index([status, createdAt])
  @@index([storePointId, status])
  @@index([productId, status])
}

model PurchaseReceipt {

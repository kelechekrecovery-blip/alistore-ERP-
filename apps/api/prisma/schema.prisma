// ---------- CORE ----------
model Customer {
  id                      String                  @id @default(cuid())
  phone                   String                  @unique // PII — маскировать младшим ролям
  // Второй канал входа в тот же аккаунт, а не вторая личность: телефон остаётся
  // первичным идентификатором (доставка и COD без него не работают). Хранится
  // нормализованным в нижнем регистре, поэтому @unique ловит и Ivan@… и ivan@….
  email                   String?                 @unique // PII — маскировать младшим ролям
  emailVerifiedAt         DateTime? // set when the OTP attach flow confirms ownership
  name                    String
  consent                 Boolean                 @default(false) // маркетинг только при true
  segments                String[]
  ltv                     Int                     @default(0)
  identities              CustomerIdentity[]
  pushTokens              PushToken[]
  addresses               CustomerAddress[]
  preferences             CustomerPreferences?
  loyaltyEntries          LoyaltyEntry[]
  coupons                 CustomerCoupon[]
  promotionRedemptions    PromotionRedemption[]
  campaignRecipients      CampaignRecipient[]
  notifications           CustomerNotification[]
  telegramAgentIdentities TelegramAgentIdentity[]
  orders                  Order[]
  tradeIns                TradeInDevice[]
  createdAt               DateTime                @default(now())
  // SupportTicket ссылается на customerId строкой (как WarrantyCase/DebtPlan) —
  // без @relation, чтобы очистка в тестах не каскадила через FK.
}

model CustomerAddress {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title          String
  text           String
  comment        String?
  isPrimary      Boolean  @default(false)
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId, isPrimary])
}

model CustomerPreferences {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  push       Boolean  @default(true)
  whatsapp   Boolean  @default(true)
  service    Boolean  @default(true)
  promos     Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// Durable customer-owned inbox projected from the transactional outbox.
model CustomerNotification {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template    String
  title       String
  detail      String
  symbol      String    @default("bell.fill")
  route       String    @default("account")
  referenceId String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}

model LoyaltyEntry {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String    @default("adjustment") // earn | redeem | refund_restore | refund_clawback | adjustment
  label      String
  amount     Int
  sourceRef  String?   @unique
  orderId    String?
  paymentId  String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([paymentId])
}

model CustomerCoupon {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  code       String
  valueLabel String
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([customerId, code])
  @@index([customerId, active])
}

model CustomerIdentity {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider    String
  subject     String
  email       String?
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, subject])
  @@index([customerId])
}

// Short-lived, one-time bridge between a verified social-provider assertion
// and phone ownership. Neither the provider credential nor the opaque
// enrollment token is stored: only non-reversible SHA-256 fingerprints.
model SocialEnrollment {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  assertionHash String   @unique
  provider      String
  subject       String
  email         String?
  displayName   String?
  avatarUrl     String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([provider, subject])
  @@index([expiresAt])
}

// Durable global budget for the deliberately narrow App Store / Play review
// credential. The row is keyed by canonical phone so attempts cannot be reset
// by changing IP, process, or API instance.
model ReviewLoginGuard {
  phone         String    @id
  attempts      Int       @default(0)
  successes     Int       @default(0)
  lockedUntil   DateTime?
  disabledAt    DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

model PushToken {
  id         String     @id @default(cuid())
  token      String     @unique
  platform   String
  deviceId   String
  appScope   String     @default("anonymous") // anonymous | customer | staff
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  enabled    Boolean    @default(true)
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, enabled])
  @@index([staffId, enabled])
  @@index([platform])
}

model Product {
  id                          String                       @id @default(cuid())
  sku                         String                       @unique
  barcode                     String?                      @unique
  variantGroup                String?
  name                        String
  price                       Int
  cost                        Int
  category                    String
  taxCode                     String                       @default("vat_standard")
  taxRateBps                  Int                          @default(1200)
  trackingMode                StockTrackingMode            @default(serialized)
  supplyMode                  SupplyMode                   @default(own_stock)
  supplyLeadDays              Int? // обязателен при supplyMode=to_order, 1..180 (CHECK в миграции)
  supplierId                  String? // внутренние данные: НЕ проецировать в публичный каталог
  supplier                    Supplier?                    @relation(fields: [supplierId], references: [id])
  supplierOffers              SupplierOffer[]
  attrs                       Json
  archived                    Boolean                      @default(false) // soft-delete: НЕ удалять физически
  updatedAt                   DateTime                     @default(now()) @updatedAt
  units                       DeviceUnit[]
  movements                   InventoryMovement[]
  balances                    InventoryBalance[]
  quantityAllocations         OrderQuantityAllocation[]
  supplyQuantityAllocations   SupplyQuantityAllocation[]
  purchaseOrderItems          PurchaseOrderItem[]
  bundleComponents            ProductBundleComponent[]     @relation("BundleProduct")
  includedInBundles           ProductBundleComponent[]     @relation("BundleComponentProduct")
  bundleAllocations           OrderBundleAllocation[]
  consignmentItems            ConsignmentItem[]
  quantityConsignmentLots     QuantityConsignmentLot[]
  serviceParts                ServicePart[]
  valuationLayers             InventoryValuationLayer[]
  valuationIssues             InventoryValuationIssue[]
  valuationReversals          InventoryValuationReversal[]
  landedCostAllocations       LandedCostAllocation[]
  exchangeReplacementRequests ExchangeRequest[]            @relation("ExchangeReplacementProduct")
  orderItems                  OrderItem[]
  supplyQuarantineResolutions SupplyQuarantineResolution[]

  @@index([category])
  @@index([variantGroup])
  @@index([archived])
  @@index([updatedAt])
  @@index([supplyMode])
  @@index([supplierId])
}

model InventoryBalance {
  id                      String                    @id @default(cuid())
  product                 Product                   @relation(fields: [productId], references: [id])
  productId               String
  location                String
  onHand                  Int                       @default(0)
  reserved                Int                       @default(0)
  inventoryValue          Int                       @default(0) // value of on-hand stock at receipt cost
  updatedAt               DateTime                  @default(now()) @updatedAt
  allocations             OrderQuantityAllocation[]
  quantityConsignmentLots QuantityConsignmentLot[]
  serviceParts            ServicePart[]
  valuationLayers         InventoryValuationLayer[]

  @@unique([productId, location])
  @@index([location])
  @@index([updatedAt])
}

model ProductBundleComponent {
  id                 String  @id @default(cuid())
  bundleProduct      Product @relation("BundleProduct", fields: [bundleProductId], references: [id])
  bundleProductId    String
  componentProduct   Product @relation("BundleComponentProduct", fields: [componentProductId], references: [id])
  componentProductId String
  qty                Int

  @@unique([bundleProductId, componentProductId])
  @@index([componentProductId])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  sku              String
  customerId       String
  customerName     String
  orderId          String
  rating           Int
  text             String?
  status           String    @default("pending")
  moderatedBy      String?
  moderatedAt      DateTime?
  moderationReason String?
  createdAt        DateTime  @default(now())

  @@unique([productId, customerId, orderId])
  @@index([productId])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([orderId])
}

model DeviceUnit {
  id                           String                      @id @default(cuid())
  imei                         String                      @unique // один IMEI нельзя продать дважды
  product                      Product                     @relation(fields: [productId], references: [id])
  productId                    String
  status                       UnitStatus                  @default(in_stock)
  grade                        Grade?
  location                     String
  acquisitionCost              Int?
  orderId                      String?
  updatedAt                    DateTime                    @default(now()) @updatedAt
  consignmentItem              ConsignmentItem?
  serviceReplacement           ServiceWorkOrder?           @relation("ServiceReplacementUnit")
  loanerProfile                LoanerDevice?
  valuationIssues              InventoryValuationIssue[]
  quarantineCases              InventoryQuarantineCase[]
  exchangeReturnRequests       ExchangeRequest[]           @relation("ExchangeReturnedUnit")
  exchangeReplacementRequests  ExchangeRequest[]           @relation("ExchangeReplacementUnit")
  landedCostAllocations        LandedCostAllocation[]
  supplyQuarantineResolution   SupplyQuarantineResolution? @relation(fields: [supplyQuarantineResolutionId], references: [id], onDelete: Restrict)
  supplyQuarantineResolutionId String?
  // повтор IMEI в trade-in + продаже → risk-флаг (проверка на сервере)

  @@index([productId])
  @@index([status])
  @@index([orderId])
  @@index([supplyQuarantineResolutionId])
  @@index([updatedAt])
}

model InventoryQuarantineCase {
  id                    String                          @id @default(cuid())
  unit                  DeviceUnit                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unitId                String
  return                Return                          @relation(fields: [returnId], references: [id], onDelete: Restrict)
  returnId              String
  sourceType            String
  reason                String
  unitCost              Int
  status                InventoryQuarantineStatus       @default(pending_diagnosis)
  diagnosis             InventoryQuarantineDiagnosis?
  disposition           InventoryQuarantineDisposition?
  notes                 String?
  createdBy             String
  diagnosedBy           String?
  disposedBy            String?
  diagnosedAt           DateTime?
  disposedAt            DateTime?
  dispositionApproval   Approval?                       @relation(fields: [dispositionApprovalId], references: [id], onDelete: Restrict)
  dispositionApprovalId String?                         @unique
  repairWorkOrder       ServiceWorkOrder?               @relation(fields: [repairWorkOrderId], references: [id], onDelete: Restrict)
  repairWorkOrderId     String?                         @unique
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([sourceType, returnId, unitId])
  @@index([status, createdAt(sort: Desc)])
  @@index([unitId, status])
  @@index([returnId])
}

model StorePoint {
  id                          String                       @id @default(cuid())
  code                        String                       @unique
  name                        String
  address                     String
  inventoryLocation           String                       @unique
  hours                       String
  pickupInstructions          String?
  active                      Boolean                      @default(true)
  sortOrder                   Int                          @default(100)
  createdBy                   String
  idempotencyKey              String                       @unique
  orders                      Order[]
  commands                    StorePointCommand[]
  staff                       StaffUser[]
  supplyQuarantineResolutions SupplyQuarantineResolution[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  edgeDevices                 EdgeDevice[]
  cameraDetections            CameraDetection[]

  @@index([active, sortOrder])
}

// Camera/edge metadata only. Raw video is intentionally outside the ERP ledger
// and must be attached through the Evidence Vault with an explicit TTL.
model EdgeDevice {
  id             String   @id @default(cuid())
  storePointId   String
  kind           String   @default("camera")
  name           String
  secretHash     String
  status         String   @default("active")
  lastSeenAt     DateTime?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  storePoint     StorePoint @relation(fields: [storePointId], references: [id], onDelete: Restrict)
  detections     CameraDetection[]

  @@index([storePointId, status])
  @@index([lastSeenAt])
}

model CameraDetection {
  id             String      @id @default(cuid())
  idempotencyKey String      @unique
  requestHash    String
  edgeDeviceId   String
  storePointId   String
  eventType      String
  confidence     Float
  value          Json
  privacyLevel   String      @default("non_identifying")
  evidenceRef    String?
  occurredAt     DateTime
  retentionUntil DateTime?
  purgedAt       DateTime?
  purgeReason    String?
  createdAt      DateTime    @default(now())
  edgeDevice     EdgeDevice  @relation(fields: [edgeDeviceId], references: [id], onDelete: Restrict)
  storePoint     StorePoint  @relation(fields: [storePointId], references: [id], onDelete: Restrict)

  @@index([storePointId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([retentionUntil])
}

model StorePointCommand {
  idempotencyKey String     @id
  storePoint     StorePoint @relation(fields: [storePointId], references: [id], onDelete: Cascade)
  storePointId   String
  fingerprint    String
  response       Json
  createdAt      DateTime   @default(now())

  @@index([storePointId, createdAt])
}

model StoreOperationChecklist {
  id             String                        @id @default(cuid())
  point          String
  businessDate   DateTime                      @db.Date
  type           StoreChecklistType
  status         StoreChecklistStatus          @default(open)
  startedBy      String
  completedBy    String?
  completedAt    DateTime?
  idempotencyKey String                        @unique
  items          StoreOperationChecklistItem[]
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([point, businessDate, type])
  @@index([point, businessDate, status])
}

model StoreOperationChecklistItem {
  id          String                  @id @default(cuid())
  checklist   StoreOperationChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  code        String
  label       String
  required    Boolean                 @default(true)
  checked     Boolean                 @default(false)
  checkedBy   String?
  checkedAt   DateTime?
  note        String?

  @@unique([checklistId, code])
  @@index([checklistId, checked])
}

model StoreIncident {
  id             String                @id @default(cuid())
  point          String
  businessDate   DateTime              @db.Date
  category       String
  severity       StoreIncidentSeverity
  status         StoreIncidentStatus   @default(open)
  title          String
  description    String
  resolution     String?
  createdBy      String
  resolvedBy     String?
  resolvedAt     DateTime?
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([point, businessDate, status])
  @@index([severity, status])

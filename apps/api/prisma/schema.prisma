  handoverIdempotencyKey   String?   @unique
  handoverAmount           Int?
  handoverReason           String?
  handedOverAt             DateTime?
  orders                   Order[]
  createdAt                DateTime  @default(now())

  @@index([courierId])
  @@index([handedOver])
}

model CourierCommand {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  courierId      String
  orderId        String
  action         String
  payload        Json
  response       Json?
  createdAt      DateTime @default(now())

  @@index([courierId, createdAt])
  @@index([orderId, createdAt])
}

model Approval {
  id                    String                   @id @default(cuid())
  action                String // discount | refund | write_off | quarantine_write_off | price | debt | delete | stock_adjust | pii
  requester             String
  approver              String?
  idempotencyKey        String?                  @unique
  sourceRef             String?                  @unique
  status                ApprovalStatus           @default(requested)
  reason                String
  evidence              Json? // обязательно для high-risk
  createdAt             DateTime                 @default(now())
  // Одноразовость одобрения. Действия из ACTION_EXECUTORS исполняются атомарно
  // в момент решения; у `discount` исполнителя нет — продажа списывает его
  // позже, и без этой отметки одно одобрение можно было проиграть на сколько
  // угодно продаж. POS-продажа проставляет consumedAt атомарным updateMany.
  consumedAt            DateTime?
  refund                Refund?
  quarantineDisposition InventoryQuarantineCase?
  exchangeRequest       ExchangeRequest?

  @@index([status])
  @@index([action])
}

model ExchangeRequest {
  id                String        @id @default(cuid())
  idempotencyKey    String        @unique
  approvalId        String        @unique
  approval          Approval      @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  status            String        @default("requested")
  requester         String
  originalOrder     Order         @relation("ExchangeOriginalOrder", fields: [originalOrderId], references: [id], onDelete: Restrict)
  originalOrderId   String
  oldUnit           DeviceUnit    @relation("ExchangeReturnedUnit", fields: [oldImei], references: [imei], onDelete: Restrict)
  oldImei           String
  newProduct        Product       @relation("ExchangeReplacementProduct", fields: [newProductId], references: [id], onDelete: Restrict)
  newProductId      String
  newUnit           DeviceUnit    @relation("ExchangeReplacementUnit", fields: [newUnitId], references: [id], onDelete: Restrict)
  newUnitId         String
  newImei           String
  creditAmount      Int
  surchargeAmount   Int
  method            PaymentMethod
  shift             CashShift?    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  shiftId           String?
  externalReference String?
  exchangeOrder     Order?        @relation("ExchangeOutputOrder", fields: [exchangeOrderId], references: [id], onDelete: Restrict)
  exchangeOrderId   String?       @unique
  return            Return?       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  returnId          String?       @unique
  expiresAt         DateTime
  executedAt        DateTime?
  rejectedAt        DateTime?
  expiredAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([originalOrderId])
  @@index([oldImei])
  @@index([newImei])
  @@index([newUnitId])
}

// Неизменяемо. Только append. Никаких update/delete. Источник правды.
model AuditEvent {
  id      String   @id @default(cuid())
  type    String // order.* payment.* stock.* approval.* и т.д.
  actor   String
  ts      DateTime @default(now())
  payload Json
  refs    String[] // связанные id (orderId, imei, shiftId…)

  @@index([type])
  @@index([actor])
  // Кокпит ERP открывает ленту событий без фильтра: `orderBy ts desc, take 50`
  // по пустому where — то есть полный проход append-only таблицы с сортировкой
  // при каждом открытии. Индекс по ts превращает это в чтение 50 строк.
  @@index([ts])
  // Та же лента с фильтром по типу (`where.type` + сортировка по ts).
  @@index([type, ts])
  @@index([refs], type: Gin) // array-containment (has/hasEvery) needs GIN, not B-tree
}

// Durable, redacted trace of an AI request. AI is an observer/recommender;
// domain mutations remain in their owning services and approval workflows.
model AiRun {
  id          String       @id @default(cuid())
  actorType   String
  actorId     String
  surface     String
  intent      String
  model       String?
  status      String       @default("started")
  errorCode   String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  steps       AiRunStep[]
  decisions   AiDecision[]

  @@index([actorId, createdAt])
  @@index([surface, createdAt])
  @@index([status, createdAt])
}

model AiRunStep {
  id           String   @id @default(cuid())
  runId        String
  run          AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind         String
  toolName     String?
  inputHash    String?
  outputSummary String?
  status       String
  createdAt    DateTime @default(now())

  @@index([runId, createdAt])
}

model AiDecision {
  id               String   @id @default(cuid())
  runId            String
  run              AiRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  summary          String
  confidence       Float?
  status           String   @default("draft")
  requiresApproval Boolean  @default(false)
  sourceRefs       String[]
  recommendation   Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([runId])
}

// A successful multipart upload is replayable by its caller's idempotency key.
// The stored asset is returned on retry and the EvidenceAttached ledger event
// is emitted exactly once.
model EvidenceUpload {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique
  actor            String
  entityType       String
  entityId         String
  label            String?
  fingerprint      String
  asset            Json
  isPii            Boolean   @default(false)
  retentionUntil   DateTime?
  purgeRequestedAt DateTime?
  purgeAttempts    Int       @default(0)
  nextPurgeAt      DateTime?
  purgedAt         DateTime?
  purgeReason      String?
  createdAt        DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([isPii, purgedAt, retentionUntil, nextPurgeAt])
}


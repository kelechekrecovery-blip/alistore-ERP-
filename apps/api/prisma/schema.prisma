// Telegram AI agent identity. A Telegram account is linked either to one
// customer or to one active staff account; the database CHECK enforces XOR.
model TelegramAgentIdentity {
  id             String                 @id @default(cuid())
  telegramUserId String                 @unique
  chatId         String
  kind           String // customer | staff
  customerId     String?                @unique
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId        String?                @unique
  staff          StaffUser?             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  displayName    String?
  active         Boolean                @default(true)
  lastSeenAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  messages       TelegramAgentMessage[]

  @@index([customerId, active])
  @@index([staffId, active])
  @@index([chatId, active])
}

// One-time staff pairing secret. Only its SHA-256 hash is persisted.
model TelegramAgentPairing {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId, expiresAt])
  @@index([expiresAt, usedAt])
}

// Durable, idempotent webhook inbox and response trace. Secrets, provider keys
// and tool payloads are never stored here.
model TelegramAgentMessage {
  id             String                 @id @default(cuid())
  externalKey    String                 @unique
  identityId     String?
  identity       TelegramAgentIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  telegramUserId String
  chatId         String
  direction      String // inbound | outbound
  text           String
  intent         String?
  status         String                 @default("received") // received | processing | answered | failed
  attempts       Int                    @default(0)
  leaseUntil     DateTime?
  responseText   String?
  createdAt      DateTime               @default(now())
  expiresAt      DateTime

  @@index([identityId, createdAt])
  @@index([telegramUserId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}


// ---------- AUTH ----------
enum OtpPurpose {
  login
  recovery
  email_attach
}

enum OtpChannel {
  sms
  email
}

// One-time login code (phone+OTP). Code stored hashed; short-lived; attempt-capped.
model OtpChallenge {
  id         String     @id @default(cuid())
  // Ровно одно из двух заполнено — какое именно, говорит `channel`. Телефон стал
  // необязательным вместе с появлением email-канала; исторические строки при
  // миграции получили channel = sms и сохранили свой phone.
  phone      String?
  email      String?
  channel    OtpChannel @default(sms)
  codeHash   String
  purpose    OtpPurpose @default(login)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone])
  @@index([email])
}

// Rotating refresh token, stored as a sha-256 hash and single-use (revoked on
// refresh). customerId is a plain indexed string to avoid coupling the Customer
// model that other modules edit concurrently.
model RefreshToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  // Set only for normal rotation. A brief replay grace lets concurrent browser
  // tabs exchange the same old HttpOnly cookie without storing plaintext.
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ---------- OUTBOX ----------
enum OutboxStatus {
  pending
  processing
  sent
  failed
  cancelled
}

// Transactional outbox for guaranteed-delivery side-effects (notifications,
// webhook follow-ups). Producers write a message in the SAME transaction as the
// business change (invariant #10); a pg-boss relay delivers it with retries.
model OutboxMessage {
  id              String       @id @default(cuid())
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId      String?
  channel         String // sms | email | push | telegram | webhook
  recipient       String
  template        String
  payload         Json
  status          OutboxStatus @default(pending)
  processingToken String?
  attempts        Int          @default(0)
  lastError       String?
  nextAttemptAt   DateTime?    @default(now())
  createdAt       DateTime     @default(now())
  sentAt          DateTime?

  @@index([status])
  @@index([status, nextAttemptAt])
  @@index([status, processingToken])
  @@index([campaignId, status])
}

// Liveness signal written by worker relays/schedulers after each pass. The
// protected operations status endpoint flags a worker as stale when its
// heartbeat is older than the freshness window.
model WorkerHeartbeat {
  id         String   @id
  lastSeenAt DateTime @updatedAt
  meta       Json?
}

// Durable compensation queue for media objects that were uploaded before a
// later database validation failed. Deletion is idempotent and retried until
// the object store accepts it.
model MediaCleanupTask {
  id               String    @id @default(cuid())
  objectKey        String    @unique
  attempts         Int       @default(0)
  deletePasses     Int       @default(0)
  lastError        String?
  nextAttemptAt    DateTime  @default(now())
  uploadLeaseUntil DateTime
  claimedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([completedAt, nextAttemptAt, uploadLeaseUntil, claimedAt])
}

// ---------- ANALYTICS ----------
// First-party storefront funnel. Deliberately separate from AuditEvent: the
// ledger is the money/stock/status spine (Invariant #10) that reports read as
// truth, and high-volume marketing telemetry must not bloat it. Still the owner's
// data — a private table, not an external tracker.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  sessionId  String
  customerId String?
  productId  String?
  source     String? // last-touch attribution (utm_source), for campaign ROI breakdown
  payload    Json     @default("{}")
  ts         DateTime @default(now())

  @@index([type, ts])
  @@index([productId])
  @@index([source, ts])
}

// ---------- STAFF AUTH ----------
// Staff login carries a role in the JWT so dangerous actions are authorized on
// the server (Role Permission Matrix), not trusted from the request body.
model StaffUser {
  id                      String                  @id @default(cuid())
  username                String                  @unique
  passwordHash            String
  role                    Role
  // Store point the account works at. References StorePoint.inventoryLocation
  // (@unique), the value `point` has always carried — a typo can no longer detach
  // an employee from every point-scoped report.
  point                   String
  storePoint              StorePoint              @relation(fields: [point], references: [inventoryLocation], onDelete: Restrict, onUpdate: Cascade)
  active                  Boolean                 @default(true)
  totpSecret              String?
  totpEnabled             Boolean                 @default(false)
  totpLastToken           String? // last used TOTP code — single-use guard (anti-replay)
  pushTokens              PushToken[]
  telegramAgentIdentities TelegramAgentIdentity[]
  telegramAgentPairings   TelegramAgentPairing[]
  assignedTasks           StaffTask[]             @relation("StaffTaskAssignee")
  createdTasks            StaffTask[]             @relation("StaffTaskCreator")
  courierOrders           Order[]                 @relation("OrderCourier")
  hrSchedules             HrSchedule[]
  hrAttendances           HrAttendance[]
  hrAbsences              HrAbsence[]
  hrPayrollLines          HrPayrollLine[]
  accountableAdvances     AccountableAdvance[]
  createdAt               DateTime                @default(now())

  @@index([role])
  @@index([point])
}


// Слайс 4 плана SUPPLY-TO-ORDER: прайс-лист поставщика — файл/строки поступают
// от партнёра без API (WhatsApp), поэтому импорт всегда двухшаговый:
// preview (stage, ничего в Product не пишет) → apply (явное решение сотрудника).
// rows хранит уже классифицированные строки, посчитанные один раз на этапе
// stage — apply читает их как есть, а не парсит файл заново, иначе preview и
// apply могли бы разойтись.
model SupplierPriceImportBatch {
  id          String                          @id @default(cuid())
  supplier    Supplier                        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId  String
  mapping     Json
  rows        Json
  summary     Json
  createdBy   String
  createdAt   DateTime                        @default(now())
  application SupplierPriceImportApplication?

  @@index([supplierId])
  @@index([createdAt])
}

// Одна строка на батч — применить дважды нельзя даже гонкой: второй apply
// упирается в @@unique([batchId]), а не в проверку «если уже применено»
// в коде до записи.
model SupplierPriceImportApplication {
  id        String                   @id @default(cuid())
  batch     SupplierPriceImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchId   String                   @unique
  appliedBy String
  appliedAt DateTime                 @default(now())
  summary   Json

  @@index([appliedAt])
}


{
  "name": "alistore-erp",
  "version": "0.0.1",
  "private": true,
  "description": "AliStore — операционная система для розничной торговли электроникой (КР)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run api:dev",
    "build": "npm run api:check && npm run api:build",
    "build:business": "npm run build -w @alistore/web",
    "api": "npm run start:dev -w @alistore/api",
    "api:dev": "npx --no-install wrangler dev --env local --persist-to .wrangler/state",
    "api:check": "node --check cloudflare/worker.js && node --test functions/**/*.test.js cloudflare/**/*.test.js scripts/__tests__/cloudflare-*.test.mjs",
    "api:contract:matrix": "node scripts/cloudflare-api-contract-matrix.mjs",
    "api:smoke:local": "node scripts/cloudflare-local-smoke.mjs",
    "infra:meili-smoke": "node scripts/meilisearch-smoke.mjs",
    "infra:metabase-smoke": "node scripts/metabase-smoke.mjs",
    "camera:edge:send": "node scripts/camera-edge-send.mjs",
    "camera:edge:send:test": "node --test scripts/__tests__/camera-edge-send.test.mjs",
    "api:build": "npm run build -w @alistore/api",
    "api:test": "npm run test -w @alistore/api -- --runInBand",
    "api:test:isolated": "node scripts/run-isolated-api-tests.mjs",
    "d1:migrate:local": "npx --no-install wrangler d1 migrations apply DB --env local --local --persist-to .wrangler/state",
    "d1:migrate:staging": "node scripts/cloudflare-remote-command.mjs migrate staging",
    "d1:migrate:production": "node scripts/cloudflare-remote-command.mjs migrate production",
    "d1:backup": "node scripts/cloudflare-remote-command.mjs backup production",
    "d1:restore:drill": "node scripts/cloudflare-restore-drill.mjs",
    "data:export:postgres": "node scripts/cloudflare-data-transfer.mjs export",
    "data:import:d1": "node scripts/cloudflare-data-transfer.mjs import",
    "data:reconcile": "node scripts/cloudflare-data-transfer.mjs reconcile",
    "deploy:staging": "node scripts/cloudflare-remote-command.mjs deploy staging",
    "deploy:review": "node scripts/cloudflare-remote-command.mjs deploy review",
    "deploy:production": "node scripts/cloudflare-remote-command.mjs deploy production",
    "release:gate": "node scripts/cloudflare-release-gate.mjs",
    "release:gate:supply": "node scripts/supply-release-gate.mjs",
    "release:gate:supply:plan": "node scripts/supply-release-gate.mjs --plan",
    "e2e": "playwright test",
    "web:route-audit": "playwright test e2e/web-route-audit.spec.ts",
    "e2e:cross-browser": "E2E_BROWSERS=chromium,webkit,firefox playwright test e2e/web-checkout.spec.ts e2e/checkout-consent.spec.ts",
    "visual:e2e": "node scripts/run-visual-acceptance.mjs",
    "mobile": "node scripts/legacy-expo-retired.mjs start",
    "mobile:typecheck": "node scripts/legacy-expo-retired.mjs typecheck",
    "mobile:store-preflight": "node scripts/legacy-expo-retired.mjs store:preflight",
    "ios:generate": "cd apps/ios && xcodegen generate",
    "ios:build": "cd apps/ios && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -project AliStoreNative.xcodeproj -alltargets -sdk iphonesimulator -configuration Debug -arch arm64 ONLY_ACTIVE_ARCH=YES CODE_SIGNING_ALLOWED=NO SYMROOT=\"$PWD/build/Products\" OBJROOT=\"$PWD/build/Intermediates.noindex\" build",
    "ios:test": "cd apps/ios && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project AliStoreNative.xcodeproj -scheme AliStoreClient -destination 'platform=iOS Simulator,name=iPhone 17 Pro' CODE_SIGNING_ALLOWED=NO",
    "ios:ui": "cd apps/ios && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project AliStoreNative.xcodeproj -scheme AliStoreUITests -destination 'platform=iOS Simulator,name=iPhone 17 Pro' CODE_SIGNING_ALLOWED=NO",
    "ios:lint": "cd apps/ios && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer swiftlint lint --quiet",
    "ios:visual": "bash apps/ios/scripts/visual-capture.sh",
    "ios:visual:client": "bash apps/ios/scripts/visual-capture.sh client",
    "ios:visual:ecosystem": "bash apps/ios/scripts/visual-capture.sh staff courier pos",
    "ios:store-screenshots": "node scripts/prepare-ios-store-screenshots.mjs",
    "ios:store-screenshots:client": "node scripts/prepare-ios-store-screenshots.mjs --app client",
    "ios:store-screenshots:test": "node --test scripts/__tests__/prepare-ios-store-screenshots.test.mjs",
    "review:seed": "node scripts/seed-review-data.mjs",
    "review:seed:test": "node --test scripts/__tests__/seed-review-data.test.mjs",
    "ios:review-credentials": "node scripts/prepare-review-credentials.mjs",
    "ios:review-readiness": "node scripts/verify-ios-review-readiness.mjs",
    "ios:review-readiness:test": "node --test scripts/__tests__/prepare-review-credentials.test.mjs scripts/__tests__/verify-ios-review-readiness.test.mjs",
    "ios:store-metadata": "node scripts/apply-ios-store-metadata.mjs",
    "ios:store-metadata:apply": "node scripts/apply-ios-store-metadata.mjs --apply",
    "ios:store-metadata:test": "node --test scripts/__tests__/apply-ios-store-metadata.test.mjs",
    "ios:store-preflight": "bash apps/ios/scripts/store-preflight.sh",
    "ios:privacy-contract": "node scripts/validate-ios-privacy-contract.mjs",
    "ios:privacy-contract:test": "node --test scripts/__tests__/validate-ios-privacy-contract.test.mjs",
    "ios:archive": "bash apps/ios/scripts/archive.sh",
    "ios:export": "bash apps/ios/scripts/export-archives.sh",
    "android:build": "cd apps/android && JAVA_HOME=/opt/homebrew/opt/openjdk@17 ./gradlew :app:assembleDebug :staff:assembleDebug :courier:assembleDebug :pos:assembleDebug",
    "android:test": "cd apps/android && JAVA_HOME=/opt/homebrew/opt/openjdk@17 ./gradlew test lintDebug",
    "android:store-preflight": "node scripts/validate-android-store-data-safety.mjs",
    "native:deeplink-preflight": "node scripts/validate-deeplink-contract.mjs",
    "android:ui": "cd apps/android && JAVA_HOME=/opt/homebrew/opt/openjdk@17 ./gradlew --no-parallel --max-workers=1 :core:connectedDebugAndroidTest :app:connectedDebugAndroidTest :staff:connectedDebugAndroidTest :courier:connectedDebugAndroidTest :pos:connectedDebugAndroidTest",
    "android:ui:all": "npm run android:ui",
    "launch:check": "npm run launch:preflight:strict && npm run launch:readiness:strict",
    "launch:activate:api": "node scripts/activate-production-api.mjs",
    "launch:preflight": "npm run preflight -w @alistore/api -- --env-file .env.production",
    "launch:preflight:strict": "npm run preflight -w @alistore/api -- --env-file .env.production --strict",
    "launch:readiness": "npm run readiness -w @alistore/api -- --env-file .env.production",
    "launch:readiness:strict": "npm run readiness -w @alistore/api -- --env-file .env.production --strict-external",
    "mvp:verify": "node scripts/mvp-verify.mjs",
    "inventory:valuation:benchmark": "npm run api:build && npm run benchmark:inventory-valuation -w @alistore/api",
    "inventory:valuation:migration-preflight": "npm run api:build && npm run benchmark:inventory-valuation-migration -w @alistore/api",
    "ecosystem:audit": "sh scripts/run-trusted-ecosystem-node.sh scripts/ecosystem-contract-audit.mjs",
    "ecosystem:audit:strict": "sh scripts/run-trusted-ecosystem-node.sh scripts/ecosystem-contract-audit.mjs --strict",
    "ecosystem:audit:json": "sh scripts/run-trusted-ecosystem-node.sh scripts/ecosystem-contract-audit.mjs --json --output .artifacts/ecosystem-audit.json",
    "ecosystem:component-verify": "node scripts/ecosystem-verify.mjs",
    "ecosystem:verify": "node scripts/ecosystem-verify.mjs",
    "ecosystem:verify:ui": "node scripts/ecosystem-verify.mjs --native-ui",
    "ecosystem:pos-refund:e2e": "playwright test e2e/ecosystem-reconciliation.spec.ts",
    "ecosystem:courier-cod:e2e": "playwright test e2e/ecosystem-courier-cod.spec.ts",
    "ecosystem:service-loaner:e2e": "npm --prefix apps/api test -- --runInBand test/service-center.e2e-spec.ts test/service-loaner.e2e-spec.ts test/warranty-rbac.e2e-spec.ts && playwright test e2e/service-center-ui.spec.ts",
    "ecosystem:procurement-sale:e2e": "npm --prefix apps/api test -- --runInBand test/procurement.e2e-spec.ts && playwright test e2e/ecosystem-procurement-sale.spec.ts",
    "ecosystem:e2e": "node scripts/run-reconciled-ecosystem-e2e.mjs",
    "ecosystem:erp-cms:e2e": "playwright test e2e/storefront-cms-ui.spec.ts",
    "web": "npm run dev -w @alistore/web",
    "local:up": "bash scripts/local-up.sh",
    "local:down": "bash scripts/local-down.sh",
    "public:up": "bash scripts/public-demo-up.sh",
    "db:migrate": "npm run db:migrate -w @alistore/api",
    "db:seed": "npm run db:seed -w @alistore/api",
    "db:studio": "npm run db:studio -w @alistore/api",
    "docs:sync": "node scripts/docs-sync.mjs",
    "migration:test:service-payment": "bash scripts/test-service-payment-migration.sh",
    "tooling:verify": "node scripts/verify-engineering-toolchain.mjs",
    "security:secrets": "gitleaks dir --redact --no-banner .",
    "security:dependencies": "osv-scanner scan source -r .",
    "web:a11y": "playwright test e2e/accessibility-smoke.spec.ts",
    "perf:smoke": "k6 run tests/performance/smoke.js",
    "api:fuzz": "schemathesis run http://127.0.0.1:4000/api/docs-json --checks all",
    "contest:judge": "node scripts/contest-judge.mjs",
    "contest:judge:test": "node --test scripts/__tests__/contest-judge.test.mjs",
    "contest:raffle": "node scripts/contest-raffle.mjs",
    "contest:raffle:test": "node --test scripts/__tests__/contest-raffle.test.mjs",
    "contest:demo": "node scripts/contest-demo/server.mjs",
    "contest:site": "node scripts/contest-site/server.mjs",
    "contest:site:test": "node --test scripts/__tests__/contest-site.test.mjs",
    "site:keepalive:test": "node --test scripts/__tests__/keep-site-up.test.mjs",
    "api:local": "node scripts/run-local-api.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "$postcss",
    "qs": "6.15.3",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1",
    "socket.io-parser": "4.2.7",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@xmldom/xmldom": "^0.9.10",
    "fast-check": "^4.9.0",
    "plist": "^3.1.1",
    "postcss": "^8.5.24",
    "testcontainers": "^12.0.4"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.28"
  }
}
